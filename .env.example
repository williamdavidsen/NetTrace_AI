# Application
APP_ENV=development
LOG_LEVEL=info

# Backend
SERVICE_NAME=nettrace-backend
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Database
POSTGRES_USER=nettrace
POSTGRES_PASSWORD=nettrace
POSTGRES_DB=nettrace
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://nettrace:nettrace@postgres:5432/nettrace

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_NAME=network_events

# Agent
AGENT_BACKEND_URL=http://backend:8000
AGENT_SCAN_ID=00000000-0000-0000-0000-000000000001
AGENT_EVENT_COUNT=10
AGENT_SEND_INTERVAL_SECONDS=1
AGENT_CAPTURE_MODE=sample
NETTRACE_EVENT_ENDPOINT=/api/v1/events
NETTRACE_SCAN_ENDPOINT=/api/v1/scans
NETTRACE_AGENT_TIMEOUT_SECONDS=5
NETTRACE_AGENT_RANDOM_SEED=42
NETTRACE_AGENT_CAPTURE_MODE=sample
NETTRACE_AGENT_CAPTURE_INTERFACE=
NETTRACE_AGENT_CAPTURE_FILTER=ip or ip6
NETTRACE_AGENT_CAPTURE_TIMEOUT_SECONDS=
NETTRACE_AGENT_SCAN_TARGET_NAME=docker-compose-agent
